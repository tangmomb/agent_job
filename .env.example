# Clé API Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Chemins (valeurs par défaut)
PROFILE_PATH=config/profile.yaml
SESSIONS_DIR=config/sessions
LETTERS_DIR=data/lettres

# Modèle du LLM
AGENT_MODEL=mistral-large-4
# Modèle (plus petit) pour remplir les formulaires de candidature
APPLY_MODEL=deepseek-v4-1-flash-1017
# true = plusieurs actions par appel (moins d'appels), false = une action par appel (plus prudent ;
# si le LLM en envoie plusieurs, seule la première est exécutée)
APPLY_PARALLEL=false
AGENT_MAX_ITERATIONS=250

# Navigateur invisible : laisser false (LinkedIn, WTTJ et Indeed refusent un Chrome invisible)
HEADLESS=false
# Navigateur installé à utiliser (chrome, msedge) ; vide = Chromium de Playwright
BROWSER_CHANNEL=chrome

# Google Sheet de suivi (ID = partie de l'URL entre /d/ et /edit)
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=
GOOGLE_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_TOKEN_FILE=config/google_token.json

# Suivi des candidatures par e-mail (accusés de réception, refus, entretiens), en IMAP.
# Laisser MAIL_ACCOUNTS vide pour ne pas relever de boîte.
MAIL_ACCOUNTS=
# Gmail : mot de passe d'application (compte Google > Sécurité > Mots de passe des applications)
MAIL_GMAIL_USER=
MAIL_GMAIL_PASSWORD=
# IONOS : adresse et mot de passe de la boîte (serveur imap.ionos.fr par défaut)
MAIL_IONOS_USER=
MAIL_IONOS_PASSWORD=
# Facultatif : MAIL_<NOM>_HOST (serveur IMAP), MAIL_<NOM>_FOLDERS (dossiers, séparés par des virgules ; défaut INBOX).
# « spam », « corbeille », « archives » désignent ces dossiers quel que soit leur nom, ex. : INBOX,spam,corbeille
# MAIL_<NOM>_WEBMAIL : modèle du lien vers un e-mail (colonne echanges_mail ; Gmail déjà connu, pas de lien possible pour IONOS),
# avec {user}, {msgid}, {folder}, {uid}
# Modèle du tri des e-mails (défaut : AGENT_MODEL), classés par lot
MAIL_MODEL=mistral-large-4
# Attente maximale du lot, en minutes (défaut 60)
MAIL_BATCH_WAIT=
# Dossier où ranger les e-mails de candidature, créé au besoin (défaut jobs_ai ; vide = pas de rangement)
MAIL_JOBS_FOLDER=jobs_ai
